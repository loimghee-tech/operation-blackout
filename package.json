{
  "name": "operation-blackout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OPERATION: BLACKOUT \u2014 a 3D browser-based first-person heist game built with Three.js, TypeScript and Vite.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch-assets": "node tools/fetch-rocketbox.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
